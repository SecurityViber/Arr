# Copy this file to .env and adjust values to your host.

# Run `id` on the host to get your UID/GID — these ensure files
# created by the containers are owned by your user, not root.
PUID=1000
PGID=1000

TZ=Europe/Berlin

# Local path for service configs. Keep this on the server's local disk —
# SQLite databases (used by all *arr apps) corrupt over SMB/NFS.
CONFIG_DIR=./config

# Synology NAS — SMB/CIFS source for downloads + media.
# The arr stack mounts //${NAS_HOST}/${NAS_PATH} as /data in every
# container, giving a layout of:
#   /data/downloads        (SABnzbd writes here)
#   /data/media/movies     (Radarr library)
#   /data/media/tv         (Sonarr library)
#   /data/media/music      (Lidarr library)
# Downloads + media share one filesystem so the arrs can hardlink
# instead of copying.
#
# NAS_PATH is "<share-name>/<subpath>" — on Synology with user home
# service enabled, your personal home is exposed as the SMB share
# named "home", so the arr folder under it is "home/arr".
NAS_HOST=192.168.156.65
NAS_PATH=home/arr
NAS_USER=chris
NAS_PASS="#Nolliebigspin1"
