# Copy this file to .env and adjust values to your host.

# Run `id` on the host to get your UID/GID — these ensure files
# created by the containers are owned by your user, not root.
PUID=1000
PGID=1000

TZ=Europe/Berlin

# Paths on the host. Can be relative (./data) or absolute (/mnt/storage).
# CONFIG_DIR holds per-service settings; keep it on fast/local storage.
# DOWNLOADS_DIR is where SABnzbd writes; *arr apps then move files from here.
# MEDIA_DIR holds the final library (movies/, tv/) that Jellyfin reads.
CONFIG_DIR=./config
DOWNLOADS_DIR=./data/downloads
MEDIA_DIR=./data/media
